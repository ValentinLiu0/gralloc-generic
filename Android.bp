cc_library_headers {
    name: "gralloc_generic_headers",
    host_supported: true,
    vendor_available: true,
    export_include_dirs: ["include/public"],
}

cc_library_shared {
    name: "libgralloc_gbm",
    header_libs: [
        "gralloc_generic_headers",
        "libhardware_headers",
        "libnativebase_headers",
        "libsystem_headers",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libdmabufheap",
        "libdrm",
        "libgbm_mesa",
        "libgralloctypes",
        "liblog",
    ],
    static_libs: [
        "libarect",
        "libaidlcommonsupport",
    ],
    local_include_dirs: [
        "include/private",
    ],
    srcs: [
        "common/gralloc_gbm.c",
    ],
    c_std: "gnu23",
    cflags: [
        "-D_GNU_SOURCE=1",
        "-D_FILE_OFFSET_BITS=64",
        "-Wall",
        "-Wsign-compare",
        "-Wpointer-arith",
        "-Wcast-qual",
        "-Wcast-align",
        "-Wno-unused-parameter",
	"-DGRALLOC_GBM_NO_CURSOR_RENDERING"
    ],
    product_variables: {
        platform_sdk_version: {
            cflags: ["-DANDROID_API_LEVEL=%d"],
        },
        debuggable: {
            cflags: [
                "-DANDROID_DEBUGGABLE",
            ],
        },
    },
    vendor: true,
}

cc_library_shared {
    name: "mapper.generic",
    relative_install_path: "hw",
    vintf_fragments: ["vintf/mapper.generic.xml"],
    header_libs: [
        "gralloc_generic_headers",
        "libbase_headers",
        "libhardware_headers",
        "libimapper_stablec",
        "libimapper_providerutils",
        "libnativebase_headers",
        "libsystem_headers",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
        "android.hardware.graphics.mapper@4.0",
        "libbase",
        "libcutils",
        "libdmabufheap",
        "libdrm",
        "libgbm_mesa",
        "libgralloc_gbm",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
        "libnativewindow",
        "libsync",
        "libutils",
    ],
    static_libs: [
        "libarect",
        "libaidlcommonsupport",
    ],
    local_include_dirs: [
        "include/private",
    ],
    srcs: [
        "mapper_stablec/backend/MapperDmaBuf.cpp",
        "mapper_stablec/backend/MapperGrallocGbm.cpp",
        "mapper_stablec/Mapper.cpp",
    ],
    cpp_std: "c++20",
    cflags: ["-Wno-sign-compare"],
    product_variables: {
        debuggable: {
            cflags: [
                "-DANDROID_DEBUGGABLE",
            ],
        },
    },
    vendor: true,
}

cc_binary {
    name: "android.hardware.graphics.allocator-service.generic",
    relative_install_path: "hw",
    init_rc: ["allocator/android.hardware.graphics.allocator-service.generic.rc"],
    vintf_fragments: ["vintf/android.hardware.graphics.allocator-service.generic.xml"],
    vendor: true,
    header_libs: [
        "gralloc_generic_headers",
        "libhardware_headers",
        "libimapper_stablec",
        "libnativebase_headers",
        "libsystem_headers",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libdmabufheap",
        "libdrm",
        "libgbm_mesa",
        "libgralloc_gbm",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
        "libnativewindow",
        "libsync",
    ],
    static_libs: [
        "libarect",
        "libaidlcommonsupport",
    ],
    local_include_dirs: [
        "include/private",
    ],
    srcs: [
        "allocator/backend/AllocatorDmaBuf.cpp",
        "allocator/backend/AllocatorGrallocGbm.cpp",
        "allocator/Allocator.cpp",
        "allocator/Main.cpp",
    ],
    cflags: [
        "-D_GNU_SOURCE=1",
        "-D_FILE_OFFSET_BITS=64",
        "-Wall",
        "-Wsign-compare",
        "-Wpointer-arith",
        "-Wcast-qual",
        "-Wcast-align",
        "-Wno-unused-parameter",
    ],
    product_variables: {
        platform_sdk_version: {
            cflags: ["-DANDROID_API_LEVEL=%d"],
        },
        debuggable: {
            cflags: [
                "-DANDROID_DEBUGGABLE",
            ],
        },
    },
}
